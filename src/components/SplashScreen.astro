<script is:inline>
    // Splash solo alla prima visita della sessione e mai con "riduci movimento".
    // Gira prima che l'overlay venga disegnato, quindi niente flash.
    try {
        if (
            sessionStorage.getItem("cilea-splash") ||
            matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            document.documentElement.classList.add("no-splash");
        } else {
            sessionStorage.setItem("cilea-splash", "1");
        }
    } catch (e) {}
</script>

<div
    id="splash-screen"
    class="fixed inset-0 z-[100] flex items-center justify-center bg-[#181211] overflow-hidden"
>
    <div class="relative flex flex-col items-center gap-8">
        <!-- Logo Container -->
        <div class="size-32 md:size-48 animate-splash-logo">
            <img
                src="/icon.svg"
                alt="Osteria Cilea Logo"
                class="w-full h-full object-contain"
            />
        </div>

        <!-- Loading Text -->
        <div class="overflow-hidden">
            <p
                class="text-white/40 text-sm tracking-[0.3em] uppercase font-light animate-splash-text"
            >
                Osteria Cilea
            </p>
        </div>
    </div>
</div>

<style>
    @keyframes splashLogo {
        0% {
            opacity: 0;
            transform: scale(0.8) translateY(20px);
        }
        50% {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
        100% {
            opacity: 1;
            transform: scale(1.1);
        }
    }

    @keyframes splashText {
        0% {
            transform: translateY(100%);
        }
        100% {
            transform: translateY(0);
        }
    }

    @keyframes fadeOut {
        to {
            opacity: 0;
            visibility: hidden;
        }
    }

    .animate-splash-logo {
        animation: splashLogo 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    .animate-splash-text {
        animation: splashText 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        animation-delay: 0.2s;
    }

    :global(.no-splash) #splash-screen {
        display: none;
    }

    .fade-out {
        animation: fadeOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
</style>

<script>
    const splashScreen = document.getElementById("splash-screen");

    if (splashScreen && !document.documentElement.classList.contains("no-splash")) {
        document.body.style.overflow = "hidden";

        setTimeout(() => {
            splashScreen.classList.add("fade-out");
            setTimeout(() => {
                document.body.style.overflow = "";
                splashScreen.style.display = "none";
            }, 400);
        }, 600);
    }
</script>
