---
import { CalendarDays } from "lucide-astro";
import WhatsAppBooking from "./WhatsAppBooking.astro";
---

<section
    id="prenota"
    class="min-h-screen flex items-center py-20 bg-cover bg-center bg-no-repeat relative overflow-hidden isolate"
>
    <!-- Slideshow for Mobile -->
    <div class="slideshow-container absolute inset-0 z-0 md:hidden">
        <div class="slide bg-[url('/images/cilea-bg-booking-smartphone.webp')]">
        </div>
        <div
            class="slide bg-[url('/images/cilea-bg-booking-smartphone-002.webp')]"
        >
        </div>
        <div
            class="slide bg-[url('/images/cilea-bg-booking-smartphone-003.webp')]"
        >
        </div>
    </div>

    <!-- Overlay for better readability -->
    <div class="absolute inset-0 bg-neutral-900/40 dark:bg-neutral-900/60 z-10">
    </div>

    <div class="max-w-[1200px] mx-auto px-6 lg:px-10 w-full relative z-20">
        <div
            class="bg-white/10 dark:bg-black/20 backdrop-blur-md border border-white/20 rounded-2xl p-8 md:p-16 flex flex-col md:flex-row items-center justify-between gap-10 shadow-2xl"
        >
            <div class="max-w-md space-y-4">
                <h2
                    class="text-4xl md:text-5xl font-bold text-white font-display italic drop-shadow-md"
                >
                    Assicura il tuo posto a tavola
                </h2>
                <p class="text-white/90 text-lg drop-shadow-sm">
                    Organizziamo cene di famiglia, eventi speciali o semplici
                    serate tra amici. Compila il modulo e inviaci la richiesta
                    su WhatsApp: ti rispondiamo noi per confermare.
                </p>
            </div>
            <div class="flex flex-col gap-4 w-full md:w-auto">
                <WhatsAppBooking />
                <div class="flex items-center gap-3 text-white/60 text-xs uppercase tracking-widest">
                    <span class="h-px flex-1 bg-white/30"></span>oppure<span class="h-px flex-1 bg-white/30"></span>
                </div>
                <a
                    href="https://www.google.com/maps/reserve/v/dine/c/CG8eycUaKzk?hl=it-IT"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-2 border-white/70 text-white px-6 py-3 rounded-xl font-bold hover:bg-white/10 transition-all flex items-center justify-center gap-3 active:scale-95"
                >
                    <CalendarDays class="w-5 h-5" aria-hidden="true" />
                    Prenota online con Google
                </a>
                <p class="text-xs text-center text-white/80">
                    Oppure chiamaci:
                    <a
                        href="tel:+393925922651"
                        class="font-bold text-white underline-offset-2 hover:underline"
                        >+39 392 592 2651</a
                    >
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* Stacking Context */
    #prenota {
        background-color: transparent;
    }

    .slide {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0;
        animation: crossfade 12s infinite ease-in-out;
    }

    .slide:nth-child(1) {
        animation-delay: 0s;
    }
    .slide:nth-child(2) {
        animation-delay: 4s;
    }
    .slide:nth-child(3) {
        animation-delay: 8s;
    }

    @keyframes crossfade {
        0% {
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        33% {
            opacity: 1;
        }
        43% {
            opacity: 0;
        }
        100% {
            opacity: 0;
        }
    }

    /* Desktop Background (Static) */
    @media (min-width: 768px) {
        #prenota {
            background-image: url("/images/cilea-bg-booking-desktop.webp");
            background-size: cover;
            background-position: center;
        }
        .slideshow-container {
            display: none;
        }
    }
</style>
