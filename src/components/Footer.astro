---
import { Instagram, Facebook, Star, ExternalLink, MapPin } from "lucide-astro";
---

<footer id="contatti" class="bg-bg-dark text-white py-16">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
        <div
            class="grid grid-cols-1 md:grid-cols-4 gap-12 border-b border-white/10 pb-12"
        >
            <div class="col-span-1 md:col-span-1 space-y-4">
                <div class="flex items-center gap-3">
                    <img
                        src="/icon.svg"
                        alt="Osteria Cilea Logo"
                        width="48"
                        height="48"
                        class="size-12"
                    />
                </div>
                <p class="text-white/60 text-sm leading-relaxed">
                    L'autentica cucina siciliana nel cuore di Palermo.
                    Tradizione, passione e amore in ogni boccone.
                </p>
                <div class="flex gap-4">
                    <a
                        href="https://www.instagram.com/osteriacilea/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Osteria Cilea su Instagram"
                        class="p-2 bg-white/5 hover:bg-primary transition-colors rounded-full"
                    >
                        <Instagram class="w-5 h-5" aria-hidden="true" />
                    </a>
                    <a
                        href="https://www.facebook.com/profile.php?id=61585332472816"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Osteria Cilea su Facebook"
                        class="p-2 bg-white/5 hover:bg-primary transition-colors rounded-full"
                    >
                        <Facebook class="w-5 h-5" aria-hidden="true" />
                    </a>
                </div>
            </div>
            <div>
                <h3
                    class="font-bold mb-6 uppercase text-xs tracking-widest text-primary"
                >
                    Orari
                </h3>
                <!-- Fonte: scheda Google Business. Tenere allineato con openingHoursSpecification in Layout.astro -->
                <a
                    href="https://maps.app.goo.gl/q6tiBoJyQDYVJGnv9"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group block text-sm text-white/60 space-y-2 hover:text-white transition-colors"
                >
                    <span class="block font-bold text-white/80">Aperti tutti i giorni</span>
                    <span class="block">Pranzo 12:30 - 15:00</span>
                    <span class="block">Cena 19:30 - 23:00</span>
                    <span
                        class="inline-flex items-center gap-1 pt-1 text-xs text-primary group-hover:underline"
                    >
                        Orari aggiornati su Google
                        <ExternalLink class="w-3 h-3" aria-hidden="true" />
                    </span>
                </a>
            </div>
            <div>
                <h3
                    class="font-bold mb-6 uppercase text-xs tracking-widest text-primary"
                >
                    Contatti
                </h3>
                <ul class="text-sm text-white/60 space-y-2">
                    <li>Via Francesco Cilea, 79</li>
                    <li>90144 Palermo, Italia</li>
                    <li>
                        <a
                            href="tel:+393925922651"
                            class="hover:text-primary transition-colors"
                            >+39 392 592 2651</a
                        >
                    </li>
                    <li class="pt-2">
                        <a
                            href="https://g.page/r/CQ-qVW7iWy7TEBM/review"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 text-white/80 hover:text-primary transition-colors"
                        >
                            <Star class="w-4 h-4" />
                            Lascia una recensione su Google
                        </a>
                    </li>
                </ul>
            </div>
            <div>
                <h3
                    class="font-bold mb-6 uppercase text-xs tracking-widest text-primary"
                >
                    Dove Siamo
                </h3>
                <!-- La mappa Google si carica solo al clic: nessun cookie di terze parti senza un'azione dell'utente -->
                <div
                    id="map-container"
                    data-map-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3138.174243457939!2d13.335098976449691!3d38.13614119126085!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1319efc9e2352cb7%3A0xd32e5be26e55aa0f!2sOsteria%20Cilea!5e0!3m2!1sit!2sit!4v1769986910173!5m2!1sit!2sit"
                    class="w-full h-32 bg-white/5 border border-white/10 rounded-lg overflow-hidden"
                >
                    <button
                        id="map-load"
                        type="button"
                        class="w-full h-full flex flex-col items-center justify-center gap-1 text-white/70 hover:text-white hover:bg-white/5 transition-colors"
                    >
                        <MapPin class="w-6 h-6 text-primary" aria-hidden="true" />
                        <span class="text-sm font-bold">Mostra la mappa</span>
                        <span class="text-[10px] text-white/40 px-4 text-center leading-tight"
                            >Caricando la mappa accetti i cookie di Google Maps</span
                        >
                    </button>
                </div>
                <a
                    href="https://maps.app.goo.gl/q6tiBoJyQDYVJGnv9"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 pt-3 text-xs text-primary hover:underline"
                >
                    Apri in Google Maps
                    <ExternalLink class="w-3 h-3" aria-hidden="true" />
                </a>
            </div>
        </div>
        <div
            class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/40"
        >
            <p>
                © {new Date().getFullYear()} Osteria Cilea di Davide Terrasi · P.IVA 07367400822
            </p>
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2 group">
                    <span class="opacity-50">Developed by</span>
                    <a
                        href="https://gofoodmenu.it"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-1.5 hover:opacity-100 transition-opacity"
                    >
                        <img
                            src="/gofood.svg"
                            alt="GO!Food Italia"
                            width="16"
                            height="16"
                            class="h-4 w-auto"
                        />
                    </a>
                </div>
                <div class="h-3 w-[1px] bg-white/10 hidden md:block"></div>
                <div class="flex gap-6">
                    <a class="hover:text-primary transition-colors" href="/privacy"
                        >Privacy e Cookie Policy</a
                    >
                </div>
            </div>
        </div>
    </div>
</footer>

<script>
    const mapButton = document.getElementById("map-load");
    const mapContainer = document.getElementById("map-container");

    mapButton?.addEventListener("click", () => {
        if (!mapContainer) return;
        const iframe = document.createElement("iframe");
        iframe.src = mapContainer.dataset.mapSrc ?? "";
        iframe.title = "Mappa: Osteria Cilea, Via Francesco Cilea 79, Palermo";
        iframe.width = "100%";
        iframe.height = "100%";
        iframe.style.border = "0";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        mapContainer.replaceChildren(iframe);
    });
</script>
