<section
    id="home"
    class="relative w-full overflow-hidden h-[100dvh] md:h-screen flex items-center justify-center bg-bg-dark"
>
    <!-- Poster: primo fotogramma del video, mostrato subito (LCP) -->
    <picture>
        <source media="(min-width: 768px)" srcset="/hero-poster.webp" width="1920" height="1080" />
        <img
            src="/hero-poster-mobile.webp"
            width="720"
            height="1280"
            alt=""
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover z-0"
        />
    </picture>

    <!-- Video caricato dopo il load della pagina (vedi script sotto) -->
    <video
        id="hero-video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        data-src-desktop="/hero-bg.mp4"
        data-src-mobile="/hero-bg-mobile.mp4"
        class="absolute inset-0 w-full h-full object-cover z-0 opacity-0 transition-opacity duration-700"
    ></video>
    <div class="absolute inset-0 bg-black/40 z-10"></div>

    <div
        class="max-w-[1200px] mx-auto px-6 lg:px-10 w-full relative z-20 py-20 flex flex-col items-center text-center"
    >
        <div class="max-w-3xl flex flex-col gap-8 animate-fade-in-up">
            <h1
                class="text-white text-5xl md:text-8xl font-bold leading-tight drop-shadow-2xl font-display italic"
            >
                <span class="sr-only">Osteria Cilea, cucina siciliana a Palermo: </span>
                Il Cuore della Sicilia <br /> a Tavola
            </h1>
            <p
                class="text-white/90 text-xl md:text-2xl font-normal max-w-2xl mx-auto italic leading-relaxed"
            >
                Ricette autentiche tramandate da generazioni, realizzate con
                ingredienti baciati dal sole del Mediterraneo.
            </p>
            <div class="flex flex-wrap justify-center gap-6 mt-4">
                <a
                    href="https://gofoodmenu.it/osteria-cilea"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-primary text-white px-10 py-5 rounded-lg text-xl font-bold shadow-2xl hover:bg-primary/90 hover:-translate-y-1 transition-all active:scale-95"
                >
                    Scopri il Menu
                </a>
                <a
                    href="#osteria"
                    class="bg-white/10 backdrop-blur-md border border-white/30 text-white px-10 py-5 rounded-lg text-xl font-bold hover:bg-white/20 transition-all active:scale-95"
                >
                    La Nostra Storia
                </a>
            </div>
        </div>
    </div>
</section>

<script>
    const video = document.getElementById("hero-video") as HTMLVideoElement | null;
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // @ts-ignore - Network Information API non tipizzata
    const saveData = navigator.connection?.saveData === true;

    if (video && !reduceMotion && !saveData) {
        const start = () => {
            const isDesktop = matchMedia("(min-width: 768px)").matches;
            video.muted = true;
            video.autoplay = true;
            video.src = (isDesktop ? video.dataset.srcDesktop : video.dataset.srcMobile) ?? "";
            video.addEventListener("playing", () => video.classList.remove("opacity-0"), { once: true });
            video.play().catch(() => {});
        };

        // Chrome rimanda l'autoplay nelle schede in background: riprova quando la pagina torna visibile
        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible" && video.src && video.paused) {
                video.play().catch(() => {});
            }
        });

        if (document.readyState === "complete") start();
        else window.addEventListener("load", start, { once: true });
    }
</script>

<style>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in-up {
        animation: fadeInUp 1s ease-out forwards;
    }
</style>
