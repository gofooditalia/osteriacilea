---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const files = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/gallery/*.webp",
    { eager: true },
);

const photos = [
    {
        file: "cilea-vertic-rigatoni-norma.webp",
        alt: "Rigatoni alla Norma",
    },
    {
        file: "cilea-vertic-spaghettoni-ricci.webp",
        alt: "Spaghettoni ai Ricci di Mare",
    },
    { file: "cilea-vertic-anciova.webp", alt: "Pasta con l'Anciova" },
    {
        file: "cilea-vertic-rigatoni-ragu.webp",
        alt: "Rigatoni al Ragù Siciliano",
    },
    {
        file: "cilea-vertic-broccolo-arriminato.webp",
        alt: "Pasta con Broccolo Arriminato",
    },
    {
        file: "cilea-vertic-sarde-beccsfico.webp",
        alt: "Sarde a Beccafico",
    },
    {
        file: "cilea-vertic-caponata-melanzane.webp",
        alt: "Caponata di Melanzane",
    },
    {
        file: "cilea-vertic-involtino-melanzane.webp",
        alt: "Involtini di Melanzane",
    },
    {
        file: "cilea-vertic-carciofi-tappo-uovo.webp",
        alt: "Carciofi col Tappo",
    },
    {
        file: "cilea-vertic-panelle-crocche.webp",
        alt: "Panelle e Crocchè",
    },
    {
        file: "cilea-vertic-frittella-ricotta.webp",
        alt: "Frittella con Ricotta",
    },
    {
        file: "cilea-vertic-gambero-marinato.webp",
        alt: "Gambero Rosso Marinato",
    },
    {
        file: "cilea-vertic-triglie-finocchietto.webp",
        alt: "Triglie al Finocchietto",
    },
    {
        file: "cilea-vertic-calamaro-arrosto.webp",
        alt: "Calamaro Arrosto",
    },
    {
        file: "cilea-vertic-insalata-aringa.webp",
        alt: "Insalata di Aringa",
    },
    {
        file: "cilea-vertic-insalata-musso-carcagnolo.webp",
        alt: "Insalata di Musso e Carcagnolo",
    },
    { file: "cilea-vertic-glassa.webp", alt: "Carne glassata" },
    {
        file: "cilea-vertic-interno-001.webp",
        alt: "L'atmosfera dell'Osteria",
    },
    { file: "cilea-vertic-interno-002.webp", alt: "Dettagli d'epoca" },
    {
        file: "cilea-vertic-interno-003.webp",
        alt: "La nostra accoglienza",
    },
    {
        file: "cilea-orizz-caserecce-lido.webp",
        alt: "Caserecce al Lido",
    },
    {
        file: "cilea-orizz-polpette-sarde-agrodolce.webp",
        alt: "Polpette di Sarde in Agrodolce",
    },
    {
        file: "cilea-orizz-primosale-fritto-acciuga.webp",
        alt: "Primosale Fritto all'Acciuga",
    },
    {
        file: "cilea-orizz-polpette-al-sugo.webp",
        alt: "Polpette al Sugo della Nonna",
    },
    {
        file: "cilea-orizz-triglie-finocchietti.webp",
        alt: "Triglie e Finocchietti",
    },
    {
        file: "cilea-orizz-grigliata-mista.webp",
        alt: "Grigliata Mista di Pesce",
    },
    { file: "cilea-orizz-frittella.webp", alt: "La nostra Frittella" },
];

const images = photos.map(({ file, alt }) => {
    const mod = files[`../assets/gallery/${file}`];
    if (!mod) throw new Error(`Gallery: immagine mancante ${file}`);
    return { src: mod.default, alt };
});
---

<section
    id="gallery"
    class="min-h-screen flex items-center py-24 bg-[#fdfaf6] dark:bg-[#1a0f0d] px-6"
>
    <div class="max-w-7xl mx-auto space-y-12">
        <div class="text-center space-y-4">
            <h2
                class="text-4xl md:text-5xl font-bold tracking-tight text-neutral-text dark:text-white font-display"
            >
                La Nostra Gallery
            </h2>
            <p
                class="text-[#896861] dark:text-[#a1928e] max-w-xl mx-auto italic text-lg"
            >
                Uno sguardo alla nostra cucina, alla sala e ai piatti che
                raccontano la nostra storia.
            </p>
        </div>

        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
            {
                images.map((img) => (
                    <div class="relative overflow-hidden rounded-xl group cursor-pointer shadow-md break-inside-avoid mb-6">
                        <Image
                            src={img.src}
                            alt={img.alt}
                            widths={[400, 600, 900]}
                            sizes="(min-width: 1280px) 410px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                            loading="lazy"
                            decoding="async"
                            class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                        <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/20 to-transparent opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 flex items-start p-6">
                            <p class="text-white font-bold text-lg md:text-xl drop-shadow-lg">
                                {img.alt}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
